# ClinNote AI — Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# HIPAA: NEVER commit .env to version control. Rotate keys regularly.

# ── Application ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Security ───────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── PHI Encryption (AES-256 Fernet) ────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_encryption_key_here

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./clinnote.db

# ── Redis / Celery ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS / Rate Limiting ────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT=5/minute

# ── Session / Recording Limits ─────────────────────────────────────────────────
SESSION_INACTIVITY_TIMEOUT=900
RECORDING_MAX_DURATION=7200
NOTE_EXPIRY_HOURS=24

# ── OpenAI (SOAP note generation) ──────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-nano-2025-04-14

# ── DeepInfra (Whisper v3 — audio transcription) ───────────────────────────────
DEEPINFRA_API_KEY=your_deepinfra_api_key_here
DEEPINFRA_WHISPER_ENDPOINT=https://api.deepinfra.com/v1/inference/openai/audio/transcriptions
DEEPINFRA_WHISPER_MODEL=openai/whisper-large-v3

# ── Azure Document Intelligence (OCR for lab reports / intake forms) ─────────────
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_azure_document_intelligence_key_here

# ── MFA ────────────────────────────────────────────────────────────────────────
TOTP_LOCKOUT_ATTEMPTS=5
TOTP_LOCKOUT_MINUTES=5
