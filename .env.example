# ============================================================================
# ClinNote AI — Environment Template
# Copy to .env and fill in real values. NEVER commit the populated .env file.
# ============================================================================

# ----- App -----
ENVIRONMENT=development                 # development | staging | production

# ----- Database -----
POSTGRES_PASSWORD=changeme              # 24+ char random in production
DATABASE_URL=postgresql+asyncpg://postgres:changeme@postgres:5432/clinnote_ai

# ----- Redis (Celery broker + result backend) -----
REDIS_URL=redis://redis:6379/0

# ----- Auth -----
# 64+ char hex string. Generate: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=replace-with-64-char-hex
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- PHI Encryption (Fernet) -----
# 44-char URL-safe base64. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MUST be set in production. MUST NOT equal SECRET_KEY. Treat as crown-jewel secret.
ENCRYPTION_KEY=replace-with-44-char-fernet-key

# ----- OpenAI (SOAP note generation) -----
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4.1-nano-2025-04-14

# ----- DeepInfra (Whisper Large v3 transcription) -----
DEEPINFRA_API_KEY=your-deepinfra-key

# ----- Azure Document Intelligence (lab-report OCR) -----
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-azure-key

# ----- Rate limiting -----
LOGIN_RATE_LIMIT=5/minute
MFA_RATE_LIMIT=5/minute
RATE_LIMIT_PER_MINUTE=60

# ----- CORS (comma-separated; do NOT include * in production with allow_credentials) -----
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ----- HIPAA session controls -----
SESSION_INACTIVITY_TIMEOUT=900          # 15 minutes (HIPAA §164.312(a)(2)(iii))
RECORDING_MAX_DURATION=7200             # 120 minutes
NOTE_EXPIRY_HOURS=24                    # Unapproved notes auto-expire

# ----- MFA -----
TOTP_LOCKOUT_ATTEMPTS=5
TOTP_LOCKOUT_MINUTES=5

# ----- Logging -----
LOG_LEVEL=INFO
